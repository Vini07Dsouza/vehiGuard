# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection (SQLAlchemy + psycopg 3)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/vehiguard

# Secret used to sign login tokens (any long random string)
JWT_SECRET=CHANGE_ME

# Password given to the four demo users created by scripts/seed_data.py.
# Leave empty to get a random password printed once when you run the seed.
SEED_USER_PASSWORD=CHANGE_ME

# Alert email (SMTP). Leave ALERT_MODE=simulated until Phase 3.
ALERT_MODE=simulated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
